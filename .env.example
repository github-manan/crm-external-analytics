# Every setting GrowthIQ reads. Copy to .env for local runs; on the server
# DevOps provides these as environment variables from the secrets manager.
# Never commit real values.

# Postgres. Local: postgresql://localhost/crm
# Production: postgres://crm_user:<password>@<rds-host>:5432/crm?sslmode=require
DATABASE_URL=

# Zoho CRM API (read-only OAuth client; scripts/authorize.py creates these)
ZOHO_ACCOUNTS_HOST=accounts.zoho.in
ZOHO_API_DOMAIN=www.zohoapis.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Assistant (Google Gemini)
GEMINI_API_KEY=
# Optional - defaults to gemini-flash-latest
GEMINI_MODEL=

# Optional - address the API server listens on (default localhost; keep it
# behind the platform's proxy, the app has no login of its own)
CRM_BIND_HOST=
